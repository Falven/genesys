{
  "name": "genesys-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Repository tooling for Genesys, a directory convention that generates native Temporal registration.",
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check:deps": "syncpack lint",
    "fix:deps": "syncpack fix && syncpack format",
    "test:e2e": "vitest run --no-file-parallelism --dir e2e --exclude \"**/fixtures/**\""
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@temporalio/client": "1.25.0",
    "@types/node": "catalog:",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "syncpack": "15.3.3",
    "turbo": "2.11.11",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.17.0"
}
